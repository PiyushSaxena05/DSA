package Patterns;

import java.util.Scanner;

public class Q7 {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("Please enter n: ");
        int n = input.nextInt();
        for (int i = 0; i <n ; i++) {

            for (int j = 1; j <=n-i-1; j++) {
                System.out.print(" ");
            }
            for (int j = 1; j <=2 * i + 1 ; j++) {
                System.out.print("*");
            }

            System.out.println();
        }
        for (int i = 0; i <n ; i++) {
            for (int j = 1; j <=i; j++) {
                System.out.print(" ");
            }
            for (int j = 1; j <= 2 * (n-i) - 1 ; j++) {
                System.out.print("*");
            }

            System.out.println();
        }
    }

