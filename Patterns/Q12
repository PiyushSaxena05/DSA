package Patterns;

import java.util.Scanner;

public class Q13 {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("Please enter n: ");
        int n = input.nextInt();
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= i; j++) {
                System.out.print(j);
            }

            for( int x = 0; x< 2*(n-i); x++){
                System.out.print(" ");
            }
            for(int j = i; j>=1; j--){
                System.out.print(j);
            }


            System.out.println();
        }



