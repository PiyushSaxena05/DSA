package Patterns;

import java.util.Scanner;

public class Q16 {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("Please enter n: ");
        int n = input.nextInt();

        for (int i = 0; i <n ; i++) {
            char ch = (char)('A'+ i);
            for (char j = 0; j <= i; j++) {
                System.out.print(ch);

            }
            System.out.println();
        }

    }
}



