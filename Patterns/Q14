package Patterns;

import java.util.Scanner;

public class Q14 {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        System.out.print("Please enter n: ");
        int n = input.nextInt();
        for (int i = 0; i <n ; i++) {
            for (char j = 'A'; j <='A'+i; j++) {
                System.out.print(j);

            }
            System.out.println();
        }
    }
}


